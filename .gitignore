# Python
__pycache__/
*.py[cod]
*.egg-info/

# Training outputs & model weights
output/
output_sda/
outputs/
*.pth
*.pt
*.pkl
*.ckpt
*.rar
*.md
*.pth.tmp
# Efficiency & server-run artifacts (per-run outputs, not source code)
efficiency_results/
prepared_lists/
pretrained_weights.rar
pretrained_weights/
# Runtime code snapshots built from the Git checkout by the launcher.
/experiment_updates/
# Local screening artifacts stay on this machine; server run logs remain trackable.
/runs/weather_local_screen/
/runs/weather_enhanced_screen/
/runs/weather_local_preflight/
/runs/weather_label_guided/
# Keep local screens and bulky server artifacts out of Git. Track only the
# four small root reports from actual server queues, not local plan folders.
/runs/weather_stability/*
!/runs/weather_stability/server_both_*/
!/runs/weather_stability/server_backlight_*/
!/runs/weather_stability/server_rainy_*/
/runs/weather_stability/server_*/**
!/runs/weather_stability/server_*/summary.csv
!/runs/weather_stability/server_*/runs.csv
!/runs/weather_stability/server_*/queue_status.json
!/runs/weather_stability/server_*/plan.json
!/runs/weather_stability/server_*/diagnostics.jsonl
!/runs/weather_stability/server_*/prediction_comparisons.csv
# Unified weather queues: only compact statistics and selected diagnostics.
/runs/weather_all/*
!/runs/weather_all/server_*/
/runs/weather_all/server_*/**
!/runs/weather_all/server_*/summary.csv
!/runs/weather_all/server_*/runs.csv
!/runs/weather_all/server_*/queue_status.json
!/runs/weather_all/server_*/plan.json
!/runs/weather_all/server_*/diagnostics.jsonl
!/runs/weather_all/server_*/prediction_comparisons.csv
!/runs/weather_all/local_*/
/runs/weather_all/local_*/**
!/runs/weather_all/local_*/summary.csv
!/runs/weather_all/local_*/runs.csv
!/runs/weather_all/local_*/queue_status.json
!/runs/weather_all/local_*/plan.json
!/runs/weather_all/local_*/diagnostics.jsonl
!/runs/weather_all/local_*/prediction_comparisons.csv
/.cache/
/Ultralytics/
# Synthetic illustrative curves must never enter real experiment uploads.
/simulations/

# Logs
*.tfevents.*


